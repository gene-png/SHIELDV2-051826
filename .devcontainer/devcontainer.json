{
  "name": "SHIELD by Kentro v2.0",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "web",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-playwright.playwright",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
          "source.organizeImports": "explicit"
        },
        "python.analysis.typeCheckingMode": "strict",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },

  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },

  "forwardPorts": [3000, 8000, 5432, 6379, 8080, 9000, 9001, 8025],
  "portsAttributes": {
    "3000":  { "label": "web (Next.js)" },
    "8000":  { "label": "api (FastAPI)" },
    "5432":  { "label": "postgres" },
    "6379":  { "label": "redis" },
    "8080":  { "label": "keycloak" },
    "9000":  { "label": "minio (S3 api)" },
    "9001":  { "label": "minio (console)" },
    "8025":  { "label": "mailhog (UI)" }
  },

  "postCreateCommand": "bash scripts/devcontainer-post-create.sh"
}
